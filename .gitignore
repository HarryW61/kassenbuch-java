# Build output (javac writes the classes and every generated report here)
out/

# Live data: bookings, yearly summaries, master data (name, tax number, address).
# The repository ships an empty KABU.DBF, an empty JABU.DBF and a placeholder STAMM.MEM so
# that a clone starts on a clean database and the Firststart assistant asks for the identity
# fields. From then on these files are private: data/.gitignore excludes everything inside,
# while the three shipped files below stay tracked.
data/.gitignore
data/*
!data/.gitignore
!data/KABU.DBF
!data/JABU.DBF
!data/STAMM.MEM

# Real legacy data from the original program: name, address, tax number. Local only.
fixtures/legacy/

# Scratch copies that tests create outside the project
/tmp/

# Backup archives produced by the Backup button and by year-end closing
*.tar.gz
*.DBF.bak
KABU.BAK
KABU.[0-9][0-9]
JABU.[0-9][0-9]

# Editors / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.iml
